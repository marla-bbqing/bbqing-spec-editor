# Copy to .env for local dev. In Vercel, set these in Project → Settings → Environment Variables.

# From Shopify Partner Dashboard → BBQing Specification Editor → Client credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Your shop domain (not the custom one)
SHOPIFY_SHOP=bbqing-com.myshopify.com

# Deployed app URL (no trailing slash). Set to your Vercel URL in production.
# For local dev: http://localhost:3030
APP_URL=https://your-vercel-url.vercel.app

# Comma-separated. Default is read/write products.
SHOPIFY_SCOPES=read_products,write_products
